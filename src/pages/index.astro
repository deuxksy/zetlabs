---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="ZetLabs — Independent game & app studio"
  description="ZetLabs is an independent studio building games, mobile apps, and utilities. Small, sharp, and made with care."
>
  <header class="site-header">
    <div class="container">
      <a class="logo" href="#top">
        <span class="z">Z</span>
        <span>ZETLABS</span>
      </a>
      <nav class="site-nav">
        <a href="#what-we-make">What we make</a>
        <a href="#apps">Apps</a>
        <a href="#utilities">Utilities</a>
        <a href="#about">About</a>
        <a class="nav-contact" href="mailto:support@zetlabs.net">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <span class="eyebrow">Independent Studio</span>
        <h1>Zet<span class="accent">Labs</span></h1>
        <p>
          We build games for players and utilities for makers.
          Small, sharp, and made with care.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="#what-we-make">What we're making</a>
          <a class="btn btn-ghost" href="mailto:support@zetlabs.net">Get in touch</a>
        </div>
      </div>
    </section>

    <section class="section" id="what-we-make">
      <div class="container">
        <span class="section-label">What we make</span>
        <h2 class="section-title">Three lanes, one standard</h2>
        <div class="card-grid">
          <div class="card">
            <div class="icon" aria-hidden="true">&#127918;</div>
            <h3>Games</h3>
            <p>
              Original titles for PC and mobile, each one designed
              around a single strong idea worth playing.
            </p>
          </div>
          <div class="card">
            <div class="icon" aria-hidden="true">&#128241;</div>
            <h3>Apps</h3>
            <p>
              Mobile tools that earn their place on your home screen
              and respect your time and attention.
            </p>
          </div>
          <div class="card">
            <div class="icon" aria-hidden="true">&#129520;</div>
            <h3>Utilities</h3>
            <p>
              Small, dependable software that does one job well —
              no accounts, no bloat, no dark patterns.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="apps">
      <div class="container">
        <span class="section-label">Apps</span>
        <h2 class="section-title">Shipping now</h2>
        <div class="game-slot">
          <div class="art art-phone">
            <img
              src="/ariadm-downloads.webp"
              alt="AriaDM downloads screen"
              loading="lazy"
            />
          </div>
          <div>
            <span class="status">Released</span>
            <h3>AriaDM</h3>
            <p>
              A remote control for aria2 on Android and iOS — watch
              speeds live, manage your queue, and get a tap when
              downloads finish.
            </p>
            <a class="btn btn-primary" href="https://ariadm.zzizily.com">Visit AriaDM</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="utilities">
      <div class="container">
        <span class="section-label">Utilities</span>
        <h2 class="section-title">Built in the open</h2>
        <div class="game-slot">
          <div class="art art-terminal" aria-hidden="true">
            <div class="term-bar"><span></span><span></span><span></span></div>
            <div class="term-body">
              <p class="term-path">statusline — claude code</p>
              <p class="term-line">
                <span class="seg-branch">☿ main</span>
                <span class="seg-cli">CLAUDE</span>
                <span class="seg-model">glm-5.3 [1m]</span>
                <span class="seg-tokens">⚡ 82K/1M (8%)</span>
              </p>
              <div class="term-tray">
                <p class="seg-quota">zai 5h 73% · mo 98%</p>
                <p class="seg-ticket">🎟️ x2 (12/22)</p>
                <p class="seg-active">✓ zai (main)</p>
              </div>
            </div>
          </div>
          <div>
            <span class="status">Free &amp; open source</span>
            <h3>statusline</h3>
            <p>
              A fast, free statusline for AI coding assistants like Claude
              Code and Codex — git branch, model, and multi-provider quota
              (Z.AI, OpenAI, Gemini) in a single line, rendered in under
              5ms. Includes a macOS tray widget for quota at a glance.
            </p>
            <a class="btn btn-primary" href="https://github.com/deuxksy/statusline">View on GitHub</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section about" id="about">
      <div class="container">
        <span class="section-label">About</span>
        <h2 class="section-title">Who is ZetLabs?</h2>
        <p>
          <strong>ZetLabs is an independent software and game studio founded in 2026.</strong>
          We're building a homegrown lineup of games, apps, and utilities —
          crafted by players, for players.
        </p>
        <p>
          No bloat, no dark patterns, no engagement traps: just things we
          believe should exist, built the way we'd want to use them ourselves.
        </p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <a class="logo" href="#top">
        <span class="z">Z</span>
        <span>ZETLABS</span>
      </a>
      <div class="links">
        <a href="mailto:support@zetlabs.net">support@zetlabs.net</a>
        <a href="https://zetlabs.net">zetlabs.net</a>
      </div>
      <span class="copyright">&copy; 2026 ZetLabs. All rights reserved.</span>
    </div>
  </footer>
</Layout>
